{
  "manifest_version": 3,
  "name": "Digital Wellbeing Website Tracker",
  "version": "0.2.1",
  "icons": { "16": "icons/logo.png", "48": "icons/logo.png", "128": "icons/logo.png" },
  "description": "Counts active website time locally for Digital Wellbeing. It does not save full URLs or collect private-window activity.",
  "key": "",
  "permissions": [
    "idle",
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
